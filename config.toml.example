# 配置为老版本适配 测试使用 不作为程序的任何负责任的依据 且这是模板文件
# 当前配置唯一能作为负责任的依据的是: [webui] port = 8579 bind = "0.0.0.0"

# ============================================================
# openlist_strm_bridge 配置文件
# ============================================================
#
# 本程序用于配合 OpenList STRM 引擎的"更新模式"。
#
# 推荐目录模型：
#
# A 区：OpenList STRM 引擎生成区
#   - 由 OpenList / STRM 引擎负责生成
#   - 程序监控并联动删除
#
# B 区：媒体库消费区
#   - 给 Emby / Jellyfin等媒体库扫描
#   - 程序会从 A 区同步 STRM 到 B 区
#   - 用户删除 B 区 STRM 时，会联动 WebDAV 删除或移动源文件
#
# C 区：幽灵/隔离区
#   - 用于存放特殊情况下迁移、隔离或失效的 STRM
#   - 日常使用频率不高，但建议保留
#
# ============================================================
#
# ⚠️ 重要变更说明：
# 以下配置已迁移到 WebUI 管理面板（配置页面 → OpenList 配置），
# 所有配置存储在 tmdb_watchlist.db 的 webui_config 表中：
#   - [webdav] WebDAV 连接配置
#   - [paths] 路径配置（b_root / c_root / refresh_paths / strm_engines）
#   - [refresh] 主动刷新配置
#   - [behavior] 行为配置
#   - [log] 日志配置
#
# 首次启动时，程序会自动将 config.toml 中的旧配置迁移到数据库。
# 迁移完成后，修改此文件中的废弃字段不再生效。
# 请通过 WebUI 管理面板修改配置。
#
# ============================================================


[local]
# SQLite 数据库文件路径。
# 可以使用相对路径，相对路径以 config.toml 所在目录为基准。
db_file = "./bridge.db"


[webui]
# 是否启用 WebUI 管理面板。
enabled = true

# WebUI 监听端口。
# 建议使用不常见的端口，避免与其他服务冲突。
# 注意：仅监听 localhost 和局域网，不开放公网。
port = 8579

# WebUI 监听地址。
# 0.0.0.0 = 监听所有本地网络接口（localhost + 局域网）
# 127.0.0.1 = 仅监听本机
# 注意：即使设置 0.0.0.0，服务也只接受本地和局域网连接
bind = "0.0.0.0"

# ============================================================
# 以下字段已废弃（迁移至 WebUI 数据库）
# ============================================================
# TMDB 配置已移至 WebUI 面板（配置页面 → TMDB 设置），
# 所有配置存储在 tmdb_watchlist.db 的 webui_config 表中。
#
# OpenList 配置已移至 WebUI 面板（配置页面 → OpenList 配置），
# 包括：webdav 连接、路径、刷新、行为、日志等所有配置。
# 首次启动时自动从 config.toml 迁移到数据库。
