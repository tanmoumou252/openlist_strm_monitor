# 配置模板：本文件仅含 [webui]，其余配置在 WebUI/DB；
# bridge.db/tmdb_watchlist.db 固定在项目根，[local].db_file 已移除；
# 其余功能配置（OpenList、TMDB、路径、刷新、行为等）通过 WebUI 管理面板
# （配置页面）在数据库中维护，本文件不承载。

# ============================================================
# openlist_strm_bridge 配置文件
# ============================================================
#
# 本程序用于配合 OpenList STRM 引擎的"更新模式"。
#
# 推荐目录模型：
#
# A 区：OpenList STRM 引擎生成区
#   - 由 OpenList / STRM 引擎负责生成
#   - 程序监控并联动删除
#
# B 区：媒体库消费区
#   - 给 Emby / Jellyfin 等媒体库扫描
#   - 程序会从 A 区同步 STRM 到 B 区
#   - 用户删除 B 区 STRM 时，会联动 WebDAV 删除或移动源文件
#
# C 区：幽灵/隔离区
#   - 用于存放特殊情况下迁移、隔离或失效的 STRM
#   - 日常使用频率不高，但建议保留

[webui]

# WebUI 监听端口。
port = 8579

# WebUI 监听地址。
# 0.0.0.0 = 监听所有本地网络接口（localhost + 局域网）
bind = "0.0.0.0"